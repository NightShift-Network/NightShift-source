# Copy to .env and fill these in. Keep .env private; it is ignored by Git.
# Generate/copy this SHA from your FreeDNS account's API page.
FREEDNS_API_SHA=

# Optional. Leave blank to choose an existing dynamic A-record host from the API.
# Create any new FreeDNS hostname in the FreeDNS web interface first.
FREEDNS_HOST=

# Hostname for the currently working NightShift instance; hostname only, no https://
NIGHTSHIFT_UPSTREAM=nightshift.example.net

# Email used for Let's Encrypt account notices.
ACME_EMAIL=admin@example.net

# Optional five-field cron schedule; default is daily at 03:17.
CRON_SCHEDULE="17 3 * * *"

# Optional. Comma-separated DNS servers used to look up proxied destination
# hostnames; default is 1.1.1.1,1.0.0.1.
WISP_DNS_SERVERS=1.1.1.1,1.0.0.1
